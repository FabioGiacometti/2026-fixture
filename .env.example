# Copy this file to `.env.local` for machine-specific overrides.
# In Vercel, add the same keys under Development, Preview, and Production.

# Leave empty or set to `/` to use the same origin as the frontend deployment.
VITE_API_BASE_URL=

# Set to `true` in Preview/Production if you want Vercel Analytics enabled.
VITE_ANALYTICS_ENABLED=false

# Optional label used for debugging/telemetry.
VITE_APP_ENV=development
